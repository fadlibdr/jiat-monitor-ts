# Postgres. The application role must NOT be the table owner / superuser, or RLS is bypassed.
# Create: CREATE ROLE jiat_app LOGIN PASSWORD '...'; GRANT jiat_app TO <migration role>;
DATABASE_URL=postgres://jiat_app:CHANGE_ME@localhost:5432/jiat
# Migration role (owner). Used only by `npm run db:migrate`.
DATABASE_URL_MIGRATE=postgres://jiat_owner:CHANGE_ME@localhost:5432/jiat
PORT=3000
APP_TIMEZONE=Asia/Jayapura
