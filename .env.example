# --- Postgres ---
# Login role for the API. Must NOT own the tables (owner/superuser bypasses RLS).
#   CREATE ROLE jiat_login LOGIN PASSWORD '...';
# `npm run db:migrate` (as the owner) then GRANTs jiat_app/jiat_holding to it and sets its default role.
DATABASE_URL=postgres://jiat_login:CHANGE_ME@localhost:5432/jiat
DATABASE_APP_LOGIN_ROLE=jiat_login
# Owner role, used only by `npm run db:migrate` / `npm run db:generate`.
DATABASE_URL_MIGRATE=postgres://jiat_owner:CHANGE_ME@localhost:5432/jiat

# --- HTTP ---
PORT=3000
NODE_ENV=development
# The built UI (cd web && npm run build), served under /app/. Relative to the working directory.
WEB_DIST_DIR=web/dist

# --- Auth (Better Auth) ---
# openssl rand -base64 48
BETTER_AUTH_SECRET=CHANGE_ME_at_least_32_characters________________
# Full URL where this API is reachable (cookies/CSRF are bound to it).
BETTER_AUTH_URL=http://localhost:3000
# Browser origins allowed to call /api/auth (comma-separated). Empty = same-origin only.
TRUSTED_ORIGINS=
# 1 = self-service sign-up open (bootstrap only). Default 0: create users with src/cli/create-user.ts.
AUTH_ALLOW_SIGNUP=0
# Sign-in rate limit (5/min/IP). Unset = on in production only; 1/0 forces it.
AUTH_RATE_LIMIT=
# CIDRs of the reverse proxy in front of the API (comma-separated), e.g. 127.0.0.1/32 behind nginx.
AUTH_TRUSTED_PROXIES=

# --- Intake: Telegram + OCR (API: webhook + review; `npm run worker`: the jobs) ---
# From @BotFather. Worker only.
TELEGRAM_BOT_TOKEN=
# Random 32–256 chars [A-Za-z0-9_-]; pass the same value to setWebhook(secret_token=...). API only.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# The bot's @username without "@" (API): POST /me/telegram-link returns a t.me deep link to link an account.
TELEGRAM_BOT_USERNAME=
# Original photos, never overwritten (API reads for the review screen, worker writes).
STORAGE_DIR=/var/lib/jiat/storage
# Any OpenAI-compatible Chat Completions endpoint with image input + json_schema output.
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL_STAGE1=
OCR_MODEL_STAGE2=
# LLD §6 thresholds
INTAKE_QUALITY_MIN=0.45
INTAKE_TOTAL_CONFIDENCE_MIN=0.70
INTAKE_MAX_PHOTO_MB=10
WORKER_POLL_MS=1000

# --- Scheduled jobs (worker) ---
# Dashboard snapshot refresh interval, minutes (LLD §9: 15).
HOLDING_MV_REFRESH_MINUTES=15
# 1 = DailyDigest 07:00 WIB to project admins and managers by Telegram DM; 0 = off.
DAILY_DIGEST=1

# --- Backup (host cron, scripts/backup-db.sh — NOT the API or worker) ---
# A role with BYPASSRLS + pg_read_all_data (NOT the owner: tables use FORCE RLS; the script checks);
# password in ~/.pgpass, never here or in the URL (refused).
# BACKUP_DATABASE_URL=postgres://jiat_backup@127.0.0.1:5432/jiat
# BACKUP_DIR=/var/backups/jiat
# BACKUP_RETENTION_DAYS=30
# Off-site copy only encrypted: a gpg PUBLIC key id/e-mail (private key kept offline), or an rclone crypt remote.
# BACKUP_RCLONE_REMOTE=s3:jiat-backup/db
# BACKUP_GPG_RECIPIENT=backup@example.co.id
# BACKUP_REMOTE_ENCRYPTED=0
